<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AntiPilot.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AntiPilot.Shell"
    Title="AntiPilot">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!--
            The window draws its own title bar: the icon and name at the top left, the backdrop
            running right up to the caption buttons, the way Windows 11 Settings does. This grid is
            the drag region; see SetTitleBar in the code-behind.
        -->
        <Grid x:Name="TitleBar" Height="36" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Images/Square44x44Logo.png" Width="16" Height="16" />
                <TextBlock x:Name="TitleText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Heading and the one card that matters before anything else: is the key pointed here. -->
        <StackPanel Grid.Row="1" Padding="24,8,24,12" Spacing="4">
            <TextBlock Text="{local:Str Key=AppName}" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{local:Str Key=SettingsTagline}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="1,0,0,10" />
            <local:SettingsCard x:Name="StatusCard" Glyph="&#xE765;">
                <local:SettingsCard.Action>
                    <Button Content="{local:Str Key=OpenWindowsSettings}" Click="OnOpenWindowsSettings" />
                </local:SettingsCard.Action>
            </local:SettingsCard>
        </StackPanel>

        <!--
            The same five pages as the WinForms window, same glyphs, same order. Text comes from
            tools\strings through {local:Str}, by the same keys the .NET window uses.
        -->
        <NavigationView
            Grid.Row="2"
            x:Name="Navigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            SelectionChanged="OnNavigationChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="{local:Str Key=TabSinglePress}" Tag="single" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{local:Str Key=TabDoublePress}" Tag="double">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE916;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{local:Str Key=TabPerApp}" Tag="rules">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xECAA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{local:Str Key=TabPalette}" Tag="palette">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{local:Str Key=TabGeneral}" Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Pages are created in code and set here; each is a Page, but no Frame is involved. -->
            <ContentControl x:Name="PageHost" Margin="0,4,24,0"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </NavigationView>

        <Grid Grid.Row="3" Padding="24,12,24,16" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button HorizontalAlignment="Left" Click="OnTest" AutomationProperties.Name="{local:Str Key=TestIt}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                    <TextBlock Text="{local:Str Key=TestIt}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" MinWidth="96" Content="{local:Str Key=Cancel}" Click="OnCancel" />
            <Button Grid.Column="2" MinWidth="96" Content="{local:Str Key=Save}" Click="OnSave"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
