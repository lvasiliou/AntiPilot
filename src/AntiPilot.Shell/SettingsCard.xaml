<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AntiPilot.Shell.SettingsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="Surface" Style="{StaticResource Card}" Padding="16,12" MinHeight="60">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <FontIcon x:Name="IconGlyph" FontSize="18" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="TitleText" TextWrapping="Wrap" />
                <TextBlock x:Name="DescriptionText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
            <ContentPresenter x:Name="ActionHost" Grid.Column="2" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
