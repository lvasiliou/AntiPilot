<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AntiPilot.Shell.SinglePressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AntiPilot.Shell">

    <!-- One card, the editor inside it. Scrolls when the file mode's rows outgrow the window. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Padding="18">
            <local:ActionEditor x:Name="Editor" />
        </Border>
    </ScrollViewer>
</Page>
