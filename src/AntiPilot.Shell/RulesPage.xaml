<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AntiPilot.Shell.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AntiPilot.Shell">

    <Grid RowDefinitions="Auto,*">
        <TextBlock Text="{local:Str Key=PerAppIntro}" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="2,0,2,10" />

        <!-- The list and its buttons share one surface: the buttons act on what the card holds. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="220,*" Margin="12,6,12,4">
                    <TextBlock Text="{local:Str Key=PerAppColumnApp}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{local:Str Key=PerAppColumnAction}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ListView x:Name="Rules" Grid.Row="1" SelectionMode="Single" DoubleTapped="OnEdit"
                          AutomationProperties.Name="{local:Str Key=TabPerApp}" />
                <TextBlock x:Name="Empty" Grid.Row="1" Text="{local:Str Key=PerAppNoRules}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="6,8,6,2">
                    <Button Content="{local:Str Key=PerAppAdd}" Click="OnAdd" />
                    <Button Content="{local:Str Key=Edit}" Click="OnEdit" />
                    <Button Content="{local:Str Key=Remove}" Click="OnRemove" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
