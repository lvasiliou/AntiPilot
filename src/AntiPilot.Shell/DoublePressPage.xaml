<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AntiPilot.Shell.DoublePressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AntiPilot.Shell">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4">
            <local:SettingsCard Glyph="&#xE916;" Title="{local:Str Key=DoubleTapEnable}"
                                Description="{local:Str Key=DoubleTapEnableDescription}">
                <local:SettingsCard.Action>
                    <ToggleSwitch x:Name="Enabled" OnContent="" OffContent="" MinWidth="0" Toggled="OnEnabledToggled" />
                </local:SettingsCard.Action>
            </local:SettingsCard>

            <local:SettingsCard x:Name="WindowCard" Glyph="&#xE916;" Title="{local:Str Key=DoubleTapWindow}">
                <local:SettingsCard.Action>
                    <Slider x:Name="Window" Width="240" Minimum="200" Maximum="1000" StepFrequency="50"
                        SnapsTo="StepValues" ValueChanged="OnWindowChanged" />
                </local:SettingsCard.Action>
            </local:SettingsCard>

            <!-- The cost of the feature, stated where it is switched on. -->
            <TextBlock x:Name="Warning" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="2,8,2,12" />

            <Border x:Name="EditorCard" Style="{StaticResource Card}" Padding="18">
                <local:ActionEditor x:Name="Editor" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
