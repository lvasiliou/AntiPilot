<?xml version="1.0" encoding="utf-8"?>
<!--
  packages.config rather than PackageReference on purpose. The C++ WinUI 3 project shape only
  works this way: with PackageReference the XAML compiler never runs and the build produces an
  executable that fails at startup with REGDB_E_CLASSNOTREG. These are the four the Windows App
  SDK needs for a native app; the versions move together.
-->
<packages>
  <package id="Microsoft.Web.WebView2" version="1.0.2903.40" targetFramework="native" />
  <package id="Microsoft.Windows.CppWinRT" version="2.0.240405.15" targetFramework="native" />
  <package id="Microsoft.Windows.ImplementationLibrary" version="1.0.260126.7" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK" version="1.7.250606001" targetFramework="native" />
</packages>
